{
  "name": "blindspot",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "docs:dev": "pnpm --filter @tindalabs/blindspot-docs dev",
    "docs:build": "pnpm --filter @tindalabs/blindspot-docs build",
    "docs:preview": "pnpm --filter @tindalabs/blindspot-docs preview",
    "size": "pnpm --filter @tindalabs/blindspot build && pnpm --filter @tindalabs/blindspot size",
    "e2e": "pnpm --filter @tindalabs/blindspot-e2e e2e",
    "lint:package": "turbo lint:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "publint": "^0.3.15",
    "turbo": "^2.9.16",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.32"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-587h-7wmj-h5pm"
      ]
    }
  }
}
