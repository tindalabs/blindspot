{
  "name": "@tindalabs/blindspot-svelte",
  "version": "0.1.1",
  "description": "Blindspot — Svelte and SvelteKit integration with stores and lifecycle hooks for automatic telemetry.",
  "keywords": [
    "opentelemetry",
    "observability",
    "frontend",
    "privacy",
    "ux",
    "svelte",
    "sveltekit",
    "store",
    "telemetry",
    "rum",
    "tracing"
  ],
  "license": "MIT",
  "author": "Isonimus",
  "homepage": "https://github.com/tindalabs/blindspot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tindalabs/blindspot.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/tindalabs/blindspot/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@tindalabs/blindspot": "workspace:*",
    "@opentelemetry/api": "^1.9.1"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^20.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
