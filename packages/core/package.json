{
  "name": "@tindalabs/blindspot-core",
  "version": "0.1.2",
  "description": "Privacy-first frontend observability — OTel wiring, privacy engine, session management",
  "keywords": [
    "opentelemetry",
    "observability",
    "frontend",
    "privacy",
    "ux",
    "telemetry",
    "rum",
    "real-user-monitoring",
    "session",
    "tracing"
  ],
  "license": "MIT",
  "author": "Isonimus",
  "homepage": "https://github.com/tindalabs/blindspot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tindalabs/blindspot.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tindalabs/blindspot/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^20.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
