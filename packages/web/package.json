{
  "name": "@tindalabs/blindspot",
  "version": "0.1.2",
  "description": "Blindspot — privacy-first auto-instrumentation for browsers. Captures Web Vitals, custom spans, and user events with built-in PII filtering.",
  "keywords": [
    "opentelemetry",
    "observability",
    "frontend",
    "privacy",
    "ux",
    "telemetry",
    "browser",
    "web",
    "rum",
    "real-user-monitoring",
    "web-vitals",
    "analytics",
    "tracing"
  ],
  "license": "MIT",
  "author": "Isonimus",
  "homepage": "https://github.com/tindalabs/blindspot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tindalabs/blindspot.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/tindalabs/blindspot/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "./dist/index.js",
      "limit": "12 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@tindalabs/blindspot-core": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-web": "^2.8.0",
    "@size-limit/file": "^12.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.10.6",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
