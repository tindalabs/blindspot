{
  "name": "@tindalabs/blindspot-next",
  "version": "0.0.1",
  "description": "Blindspot — Next.js integration supporting both App Router and Pages Router for server-rendered and hybrid applications.",
  "keywords": [
    "opentelemetry",
    "observability",
    "frontend",
    "privacy",
    "ux",
    "next",
    "nextjs",
    "app-router",
    "pages-router",
    "server-components",
    "telemetry",
    "rum",
    "tracing"
  ],
  "license": "MIT",
  "author": "Isonimus",
  "homepage": "https://github.com/tindalabs/blindspot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tindalabs/blindspot.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/tindalabs/blindspot/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@tindalabs/blindspot": "workspace:*",
    "@opentelemetry/api": "^1.9.1"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^17.0.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
