{
  "name": "@tindalabs/blindspot-react",
  "version": "0.1.1",
  "description": "Blindspot — React integration. BlindspotProvider, BlindspotRoutes, and useSpan hook for React 18+ applications.",
  "keywords": [
    "opentelemetry",
    "observability",
    "frontend",
    "privacy",
    "ux",
    "react",
    "react-hooks",
    "provider",
    "telemetry",
    "rum",
    "tracing"
  ],
  "license": "MIT",
  "author": "Isonimus",
  "homepage": "https://github.com/tindalabs/blindspot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tindalabs/blindspot.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/tindalabs/blindspot/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./react-router": {
      "import": "./dist/react-router.js",
      "require": "./dist/react-router.cjs",
      "types": "./dist/react-router.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/react-router.tsx --format esm,cjs --dts --clean --external react --external react-dom --external react-router-dom",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@tindalabs/blindspot": "workspace:*",
    "@opentelemetry/api": "^1.9.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^20.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
